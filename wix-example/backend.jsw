// backend/leadIntake.jsw
//
// Wix Velo BACKEND web module. This is the only place the webhook secret
// ever lives — backend .jsw files run server-side only and are never sent
// to the browser, unlike frontend page code. The frontend (see
// frontend.js in this same folder) calls this function; this function is
// the only thing that ever talks to our webhook.
//
// Setup (one-time, in the Wix Editor):
//   1. Site → Settings → Secrets Manager → add a secret named
//      "dmaWixWebhookSecret" whose value matches this service's
//      WIX_WEBHOOK_SECRET environment variable exactly.
//   2. Create this file at backend/leadIntake.jsw in your Wix site's code
//      panel (Velo sidebar → Backend).
//   3. Replace LEAD_INTAKE_URL below with this service's real deployed URL.

import { fetch } from 'wix-fetch';
import { getSecret } from 'wix-secrets-backend';

const LEAD_INTAKE_URL = 'https://<your-railway-domain>/api/leads/wix';
const SECRET_NAME = 'dmaWixWebhookSecret';

// `formData` is whatever the frontend collected — see frontend.js for the
// exact shape. This function does no field mapping of its own; it just
// authenticates and forwards. All the real mapping/validation logic lives
// server-side in wix-lead-intake.js, so it can change without needing a
// matching Wix code redeploy.
export async function submitDmaLead(formData) {
  const secret = await getSecret(SECRET_NAME);

  const response = await fetch(LEAD_INTAKE_URL, {
    method: 'POST',
    headers: {
      'content-type': 'application/json',
      authorization: `Bearer ${secret}`,
    },
    body: JSON.stringify(formData),
  });

  // Wix's fetch() resolves even on a non-2xx status — check explicitly
  // rather than assuming success, so the frontend gets a real error back
  // instead of silently treating a 400/401/502 as if the lead was saved.
  let result;
  try {
    result = await response.json();
  } catch (err) {
    result = { success: false, error: 'invalid response from lead intake service' };
  }

  if (!response.ok || !result.success) {
    // Never echo the secret or any GHL-internal detail back to the
    // frontend — result.error from the webhook is already a safe, generic
    // string (see server.js), but re-wrap defensively in case that ever
    // changes.
    throw new Error(result.error || `Lead intake failed (HTTP ${response.status})`);
  }

  return { success: true, contactId: result.contactId, created: result.created };
}
